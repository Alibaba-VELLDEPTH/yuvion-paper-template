% Vector icons, editorial rules, and arrow placement follow the reference links.
\newcommand{\paperlinkglyph}[1]{%
  \begin{tikzpicture}[x=1pt,y=1pt,baseline=-2pt,line width=.7pt,
    line cap=round,line join=round]
  \path[use as bounding box] (0,0) rectangle (12,11);
  \ifstrequal{#1}{Project}{%
    \draw[reportgray] (1,5.2)--(6,9.7)--(11,5.2)
      (2.5,4.9)--(2.5,1)--(9.5,1)--(9.5,4.9);
    \draw[reportaccent] (5,1)--(5,4.1)--(7,4.1)--(7,1);
  }{}%
  \ifstrequal{#1}{Code}{%
    \draw[reportgray] (3.6,8.4)--(.8,5.5)--(3.6,2.6)
      (8.4,8.4)--(11.2,5.5)--(8.4,2.6);
    \draw[reportaccent] (7.1,9)--(4.9,2);
  }{}%
  \ifstrequal{#1}{Models}{%
    \draw[reportgray] (1.2,6)--(6,3.7)--(10.8,6)
      (1.2,3.6)--(6,1.3)--(10.8,3.6);
    \draw[reportaccent] (1.2,8.4)--(6,10.7)--(10.8,8.4)--(6,6.1)--cycle;
  }{}%
  \end{tikzpicture}}
\newcommand{\paperlinkentry}[2]{\href{#1}{%
  \begin{tikzpicture}[baseline=(label.base)]
  \node[minimum width=74pt,minimum height=12pt,inner sep=0pt] (entry) {};
  \node[anchor=west,inner sep=0pt] at (entry.west) {\paperlinkglyph{#2}};
  \node[anchor=west,inner sep=0pt,text=reportink] (label)
    at ([xshift=18pt]entry.west) {\MakeUppercase{#2}};
  \draw[reportaccent,line width=.6pt,line cap=round,line join=round]
    ([xshift=-5pt,yshift=-1.5pt]entry.east)--([yshift=3pt]entry.east)
    ([xshift=-3.5pt,yshift=3pt]entry.east)--([yshift=3pt]entry.east)--([yshift=-.5pt]entry.east);
  \draw[reportrule,line width=.4pt]
    ([yshift=-4.5pt]label.base -| entry.west)--([yshift=-4.5pt]label.base -| entry.east);
  \draw[reportaccent,line width=.65pt]
    ([yshift=-4.5pt]label.base -| entry.west)--++(8pt,0);
  \end{tikzpicture}}}
\newcommand{\paperlinks}{\par\vspace{3pt}\begingroup
  \sffamily\fontsize{7.5}{10}\selectfont
  \noindent\makebox[\linewidth][c]{\scalebox{.9}{\paperlinkentry{\projecturl}{Project}}\hspace{24pt}%
  \scalebox{.9}{\paperlinkentry{\codeurl}{Code}}\hspace{24pt}\scalebox{.9}{\paperlinkentry{\modelsurl}{Models}}}
  \par\endgroup}
